# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# case import drafts (working output, reviewed by hand before merging into src/data)
/scripts/output/

# local Claude Code session state (machine-specific, not shared config)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# netlify CLI local state
.netlify

# build tarballs
*.tar.gz
